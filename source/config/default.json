{
  "schema_version": 1,
  "logging": {
    "enabled": true,
    "retention_days": 14,
    "max_file_bytes": 20971520,
    "max_total_bytes": 1073741824
  },
  "web": {
    "base_path": "/home"
  },
  "storage": {
    "reserve_gib": 5,
    "base_cache_gib": 20,
    "base_cache_days": 7,
    "source_cache_gib": 20,
    "source_evict_below_gib": 20,
    "episode_budget_gib": 2
  },
  "render": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "video_codec": "libx264",
    "audio_codec": "aac",
    "audio_rate": 44100,
    "audio_channels": 2,
    "crf": 18,
    "preset": "medium",
    "hook_duration_ms": 4500,
    "title_card_duration_ms": 1500,
    "duration_tolerance_ms": 500,
    "hook_style": "auto",
    "hook_fade_out_ms": 1000,
    "hook_layout_version": 8,
    "hook_emphasis": "ai_semantic_v1"
  },
  "publish": {
    "oss_prefix": "fb-bm-assets",
    "feishu_initial_status": "待处理",
    "wait_timeout_seconds": 1800,
    "poll_seconds": 15
  },
  "preview": {
    "oss_enabled": true
  },
  "material_lifecycle": {
    "enabled": false,
    "delivery_enabled": false
  }
}
