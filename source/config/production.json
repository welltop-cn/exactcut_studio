{
  "environment": "production",
  "web": {
    "base_path": "/exactcut"
  },
  "storage": {
    "reserve_gib": 10,
    "base_cache_gib": 8,
    "base_cache_days": 7,
    "source_cache_gib": 8,
    "source_evict_below_gib": 16,
    "episode_budget_gib": 2
  },
  "concurrency": {
    "enabled": true,
    "fetch": 2,
    "render": 3,
    "upload": 2,
    "poll": 4,
    "max_active_children": 11,
    "hook_previews": 1,
    "ai": {
      "requests_per_minute": 6,
      "burst": 1
    }
  }
}
