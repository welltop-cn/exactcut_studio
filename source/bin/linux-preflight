#!/bin/sh
set -eu
deploy_root=/srv/exactcut
image=''
drama_id=''
sample_mib=32
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) deploy_root="$2"; shift 2 ;;
    --image) image="$2"; shift 2 ;;
    --drama-id) drama_id="$2"; shift 2 ;;
    --sample-mib) sample_mib="$2"; shift 2 ;;
    *) echo 'Usage: linux-preflight --image IMAGE --drama-id ID [--root DIR] [--sample-mib 1..64]' >&2; exit 2 ;;
  esac
done
if [ -z "$image" ] || [ -z "$drama_id" ]; then
  echo 'An explicit image and existing drama ID are required.' >&2
  exit 2
fi
case "$deploy_root" in
  /*) ;;
  *) echo 'Deployment root must be absolute.' >&2; exit 2 ;;
esac
if [ ! -f "$deploy_root/config/production.env" ]; then
  echo 'Production config does not exist under deployment root.' >&2
  exit 2
fi
# No data volume, published ports or worker; destroy the probe container on exit.
exec docker run --rm --cpus=1 --memory=1g --pids-limit=128 \
  --entrypoint python \
  -v "$deploy_root/config/production.env:/run/exactcut/production.env:ro" \
  -e EXACTCUT_ENVIRONMENT=production \
  -e EXACTCUT_ENV_FILE=/run/exactcut/production.env \
  -e EXACTCUT_ALLOW_AI=1 -e EXACTCUT_ALLOW_PUBLISH=1 \
  -e EXACTCUT_ALLOW_MATERIAL_FETCH=0 -e EXACTCUT_WORKER_ENABLED=0 \
  "$image" -m exactcut.preflight --drama-id "$drama_id" --sample-mib "$sample_mib"
