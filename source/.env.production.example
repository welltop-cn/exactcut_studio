# Server only: <deployment root>/config/production.env, permissions 0600.
# Fill from verified production settings; never commit actual credentials.
EXACTCUT_ENVIRONMENT=production

# Episode download and asset upload
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_SOURCE_BUCKET=
ALIYUN_OSS_PREFIX=fb-bm-assets
ALIYUN_OSS_PUBLIC_BASE_URL=

# Responses API: confirm endpoint and models using the actual provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
EXACTCUT_HOOK_MODEL=
EXACTCUT_INTAKE_MODEL=
EXACTCUT_HELP_MODEL=

# Application alerts (also enable alerts.enabled in runtime.json)
FEISHU_ALERT_WEBHOOK=

# Feishu publishing queue
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
OPENCLAW_SOURCE_USER=exact-cut-fbbm

# CF-Ads / FBBM
CF_ADS_BASE_URL=
CF_ADS_USERNAME=
CF_ADS_PASSWORD=
MAX_TASKS_PER_RUN=10
MAX_RETRIES=2
NEXT_POLL_SECONDS=60
HTTP_TIMEOUT_SECONDS=30

# Optional broader Material Hub sync; not used by direct episode downloads.
# METABASE_HOST=
# METABASE_USER=
# METABASE_PASSWORD=
# MATERIAL_HUB_FEISHU_APP_ID=
# MATERIAL_HUB_FEISHU_APP_SECRET=
